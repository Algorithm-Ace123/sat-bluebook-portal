# Example environment variables for local development and deployment
# Copy this to `.env.local` (do NOT commit the real file) and fill in your keys.

# Public Supabase credentials (safe for client-side usage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only credentials (DO NOT expose to client or commit)
# Required by certain admin / server routes (create-user, assignments/create)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: any other env vars your deployment needs
# e.g. NEXT_PUBLIC_APP_NAME=Pramana
